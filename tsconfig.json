{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client", "node"],
    "strict": true
  },
  "include": [
    "src/App.jsx",
    "src/main.jsx",
    "src/projects.js",
    "src/experience.js",
    "src/prerender.jsx"
  ]
}
